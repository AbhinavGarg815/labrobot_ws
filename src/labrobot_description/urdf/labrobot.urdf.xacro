<?xml version="1.0"?>
<!--
  labrobot - two-wheeled differential-drive indoor robot on four swivel casters.

  Perception is camera-only: an Intel RealSense D435i on a mast at ~0.84 m,
  pitched 10.78 deg down (measured as-built; the design intent was 15 deg).
  There is no lidar.

  Build for the real robot (default):
      xacro labrobot.urdf.xacro
  Build for Gazebo:
      xacro labrobot.urdf.xacro use_sim:=true

  All calibratable numbers live in labrobot_properties.xacro.
-->
<robot name="labrobot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Target selection. use_sim swaps the ros2_control hardware plugin and
       pulls in the Gazebo sensor/plugin block. -->
  <xacro:arg name="use_sim" default="false"/>
  <xacro:property name="use_sim" value="$(arg use_sim)"/>

  <!-- Serial link to the Arduino Mega (hardware only). The default is the udev
       symlink installed by scripts/00_setup_jetson.sh. -->
  <xacro:arg name="mcu_port" default="/dev/labrobot_mcu"/>
  <xacro:arg name="mcu_baud" default="500000"/>

  <!-- Only consumed by the Gazebo plugin block, so it defaults to the sim
       config. On hardware the controller_manager is configured from the launch
       file with config/controllers.yaml instead. -->
  <xacro:arg name="controllers_config"
             default="$(find labrobot_description)/config/controllers_gazebo.yaml"/>

  <xacro:include filename="$(find labrobot_description)/urdf/labrobot_properties.xacro"/>
  <xacro:include filename="$(find labrobot_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find labrobot_description)/urdf/labrobot.ros2_control.xacro"/>

  <xacro:if value="${use_sim}">
    <xacro:include filename="$(find labrobot_description)/urdf/labrobot.gazebo.xacro"/>
  </xacro:if>

  <xacro:labrobot_ros2_control
      use_sim="${use_sim}"
      mcu_port="$(arg mcu_port)"
      mcu_baud="$(arg mcu_baud)"/>

  <!-- Zero-friction contact sphere for one fixed caster. Declared here so it
       can be expanded inside base_link below. -->
  <xacro:macro name="caster_collision" params="name x y">
    <collision name="${name}">
      <origin xyz="${x} ${y} ${caster_radius}" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
  </xacro:macro>

  <!-- ======================================================================
       Base

       base_link's origin sits on the ground plane directly below the robot
       centre, so base_footprint coincides with it exactly. Kept as a separate
       link because Nav2 and the diff_drive_controller both expect it.
       ====================================================================== -->

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0.00020754618383456714 2.2959994762941868e-05 0.09300166322303284" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia ixx="0.311017" iyy="0.287711" izz="0.217957" ixy="-5e-06" iyz="-6.5e-05" ixz="-0.000417"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find labrobot_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>

    <!-- Collision is built from primitives rather than the 230k-triangle visual
         mesh. The mesh costs milliseconds per contact query and buys nothing:
         the chassis is a box with a thin mast on top. Extents come from a
         height-banded cross-section of base_link.stl. -->
    <collision name="body_collision">
      <origin xyz="0 0 ${body_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>

    <collision name="mast_collision">
      <origin xyz="0 ${mast_y} ${(mast_top + body_height) / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${mast_length} ${mast_width} ${mast_top - body_height}"/>
      </geometry>
    </collision>

    <!-- Four SWIVEL casters, one per corner. They are already part of the
         base_link mesh, so they get no links of their own - just zero-friction
         contact spheres so the chassis rests on four points instead of dragging
         its collision box. Modelling the pivot would only matter if we needed
         to simulate the sideways kick they give at each direction change. -->
    <xacro:caster_collision name="caster_fl" x="${ caster_inset_x}" y="${ caster_inset_y}"/>
    <xacro:caster_collision name="caster_fr" x="${ caster_inset_x}" y="${-caster_inset_y}"/>
    <xacro:caster_collision name="caster_rl" x="${-caster_inset_x}" y="${ caster_inset_y}"/>
    <xacro:caster_collision name="caster_rr" x="${-caster_inset_x}" y="${-caster_inset_y}"/>
  </link>

  <!-- ======================================================================
       Drive wheels

       The visual origins cancel the joint origins because the STLs were
       exported in the assembly frame rather than about each part's own origin.
       Do not "simplify" them away - the meshes would fly off to the corner.
       ====================================================================== -->

  <xacro:macro name="drive_wheel" params="side reflect">
    <link name="${side}_wheel_link">
      <inertial>
        <origin xyz="0 ${reflect * 0.016} 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.000166" iyy="0.000292" izz="0.000166" ixy="0.0" iyz="0.0" ixz="0.0"/>
      </inertial>

      <visual>
        <origin xyz="0.0 ${-reflect * wheel_joint_y} ${-wheel_radius}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find labrobot_description)/meshes/${side}_wheel.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>

      <!-- A cylinder about the rolling axis. Rotated onto Y because URDF
           cylinders are defined along Z. -->
      <collision>
        <origin xyz="0 ${reflect * 0.016} 0" rpy="${half_pi} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <origin xyz="0.0 ${reflect * wheel_joint_y} ${wheel_radius}" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel side="left"  reflect="1"/>
  <xacro:drive_wheel side="right" reflect="-1"/>

  <!-- ======================================================================
       RealSense D435i

       Two links, on purpose:
         camera_mount_link - unrotated, carries the visual mesh (the STL is
                             exported in the assembly frame with the design's
                             15 deg baked in, so the visual counter-rotates)
         camera_link       - the real optical mounting frame, at the MEASURED
                             10.78 deg, and the frame realsense2_camera hangs
                             its own factory-calibrated frames beneath
       ====================================================================== -->

  <!-- Unrotated, and carries the visual. Keeping it unrotated is what lets the
       mesh transform stay simple; the as-built tilt lives on camera_link. -->
  <link name="camera_mount_link">
    <inertial>
      <origin xyz="0.011258465185769444 -0.00043994587150039265 -0.003033037165243946" rpy="0 0 0"/>
      <mass value="${camera_mass}"/>
      <inertia ixx="3.4e-05" iyy="5e-06" izz="3.4e-05" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>

    <!-- The origin here counter-rotates the mesh from the design's 15 deg to the
         as-built 10.78 deg, so the rendered camera matches its own TF axes.
         xyz is -R*c, not -c, because the rotation moves the mesh too. -->
    <visual>
      <origin xyz="${camera_visual_x} ${camera_visual_y} ${camera_visual_z}"
              rpy="0 ${camera_visual_pitch} 0"/>
      <geometry>
        <mesh filename="file://$(find labrobot_description)/meshes/camera_d435i.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>

    <collision>
      <origin xyz="0.0125 0 0" rpy="0 ${camera_pitch} 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_mount_joint" type="fixed">
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_mount_link"/>
  </joint>

  <!-- camera_link is the frame realsense2_camera publishes its internal frames
       FROM, so it must be the true optical mounting frame: tilted by the
       MEASURED 10.78 deg, not the design's 15 deg.
       Splitting it out this way keeps the visual mesh transform untouched -
       rotating camera_link directly would have meant counter-rotating the mesh
       origin by hand, which is easy to get subtly wrong.

       Everything below camera_link (depth / colour / IMU frames and their
       optical variants) is deliberately NOT defined here. The camera publishes
       those itself from its factory calibration, which carries this unit's real
       depth-to-colour imager misalignment (measured: 0.98 deg of roll). The URDF
       cannot know that number, and a nominal zero would tilt the point cloud by
       ~34 mm at 2 m. Division of labour: the URDF owns where the camera is
       BOLTED, the camera owns what it is internally.

       Consequence: those frames only exist while the camera node is running,
       and camera.launch.py must keep camera_publish_tf:=true. -->
  <link name="camera_link"/>

  <joint name="camera_optical_mount_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${camera_roll} ${camera_pitch} 0"/>
    <parent link="camera_mount_link"/>
    <child link="camera_link"/>
  </joint>


</robot>
