<?xml version="1.0"?>
<!-- labrobot - two-wheeled differential-drive indoor robot on four swivel casters. -->
<robot name="labrobot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Target selection. use_sim swaps the ros2_control hardware plugin and pulls in the Gazebo sensor/plugin block. -->
  <xacro:arg name="use_sim" default="false"/>
  <xacro:property name="use_sim" value="$(arg use_sim)"/>

  <!-- Serial link to the Arduino Mega (hardware only). -->
  <xacro:arg name="mcu_port" default="/dev/labrobot_mcu"/>
  <xacro:arg name="mcu_baud" default="500000"/>

  <!-- Only consumed by the Gazebo plugin block, so it defaults to the sim config. -->
  <xacro:arg name="controllers_config"
             default="$(find labrobot_description)/config/controllers_gazebo.yaml"/>

  <xacro:include filename="$(find labrobot_description)/urdf/labrobot_properties.xacro"/>
  <xacro:include filename="$(find labrobot_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find labrobot_description)/urdf/labrobot.ros2_control.xacro"/>

  <xacro:if value="${use_sim}">
    <xacro:include filename="$(find labrobot_description)/urdf/labrobot.gazebo.xacro"/>
  </xacro:if>

  <xacro:labrobot_ros2_control
      use_sim="${use_sim}"
      mcu_port="$(arg mcu_port)"
      mcu_baud="$(arg mcu_baud)"/>

  <!-- Zero-friction contact sphere for one fixed caster. -->
  <xacro:macro name="caster_collision" params="name x y">
    <collision name="${name}">
      <origin xyz="${x} ${y} ${caster_radius}" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
  </xacro:macro>


  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0.00020754618383456714 2.2959994762941868e-05 0.09300166322303284" rpy="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia ixx="0.311017" iyy="0.287711" izz="0.217957" ixy="-5e-06" iyz="-6.5e-05" ixz="-0.000417"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find labrobot_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>

    <!-- Collision is built from primitives rather than the 230k-triangle visual mesh. -->
    <collision name="body_collision">
      <origin xyz="0 0 ${body_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>

    <collision name="mast_collision">
      <origin xyz="0 ${mast_y} ${(mast_top + body_height) / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${mast_length} ${mast_width} ${mast_top - body_height}"/>
      </geometry>
    </collision>

    <!-- Four SWIVEL casters, one per corner. -->
    <xacro:caster_collision name="caster_fl" x="${ caster_inset_x}" y="${ caster_inset_y}"/>
    <xacro:caster_collision name="caster_fr" x="${ caster_inset_x}" y="${-caster_inset_y}"/>
    <xacro:caster_collision name="caster_rl" x="${-caster_inset_x}" y="${ caster_inset_y}"/>
    <xacro:caster_collision name="caster_rr" x="${-caster_inset_x}" y="${-caster_inset_y}"/>
  </link>


  <xacro:macro name="drive_wheel" params="side reflect">
    <link name="${side}_wheel_link">
      <inertial>
        <origin xyz="0 ${reflect * 0.016} 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.000166" iyy="0.000292" izz="0.000166" ixy="0.0" iyz="0.0" ixz="0.0"/>
      </inertial>

      <visual>
        <origin xyz="0.0 ${-reflect * wheel_joint_y} ${-wheel_radius}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find labrobot_description)/meshes/${side}_wheel.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>

      <!-- A cylinder about the rolling axis. -->
      <collision>
        <origin xyz="0 ${reflect * 0.016} 0" rpy="${half_pi} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <origin xyz="0.0 ${reflect * wheel_joint_y} ${wheel_radius}" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel side="left"  reflect="1"/>
  <xacro:drive_wheel side="right" reflect="-1"/>


  <!-- Unrotated, and carries the visual. -->
  <link name="camera_mount_link">
    <inertial>
      <origin xyz="0.011258465185769444 -0.00043994587150039265 -0.003033037165243946" rpy="0 0 0"/>
      <mass value="${camera_mass}"/>
      <inertia ixx="3.4e-05" iyy="5e-06" izz="3.4e-05" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </inertial>


    <visual>
      <origin xyz="${camera_visual_x} ${camera_visual_y} ${camera_visual_z}"
              rpy="0 ${camera_visual_pitch} 0"/>
      <geometry>
        <mesh filename="file://$(find labrobot_description)/meshes/camera_d435i.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>

    <collision>
      <origin xyz="0.0125 0 0" rpy="0 ${camera_pitch} 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_mount_joint" type="fixed">
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="camera_mount_link"/>
  </joint>


  <link name="camera_link"/>

  <joint name="camera_optical_mount_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${camera_roll} ${camera_pitch} 0"/>
    <parent link="camera_mount_link"/>
    <child link="camera_link"/>
  </joint>


</robot>
