  <transport_descriptors>
    <transport_descriptor>
      <transport_id>labrobot_shm</transport_id>
      <type>SHM</type>
      <segment_size>8388608</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>labrobot_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="labrobot_default_participant" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>labrobot_shm</transport_id>
        <transport_id>labrobot_udp</transport_id>
      </userTransports>
    </rtps>
  </participant>
</profiles>
