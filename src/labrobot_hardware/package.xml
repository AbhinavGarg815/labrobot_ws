<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>labrobot_hardware</name>
  <version>1.0.0</version>
  <description>
    ros2_control SystemInterface for the labrobot drivetrain. Speaks the framed
    binary protocol to the Arduino Mega, which in turn drives the two RMCS-2303
    servo drives over MODBUS ASCII.
  </description>
  <maintainer email="abhinavgrg815@gmail.com">Abhinav</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/labrobot_hardware.xml"/>
  </export>
</package>
