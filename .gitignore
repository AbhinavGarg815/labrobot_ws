# colcon build outputs - regenerated by `colcon build --symlink-install`
build/
install/
log/

# Python bytecode
__pycache__/
*.pyc

# Maps: RTAB-Map databases are hundreds of MB to GB, exported clouds tens of MB.
# Backed up under docs/maps/backup/ on the Jetson, not in git.
*.db
*.db-journal
*.ply
*.pcd

# Run logs from hardware sessions (bulky, regenerated every run). The findings
# they support are written into docs/PROJECT_REPORT.md, which IS tracked.
docs/logs/

# Local build of the RealSense link probe (tools/rs_link_probe.cpp)
tools/rs_link_probe

# Firmware host-test build outputs
firmware/test/*.o
firmware/test/test_*
!firmware/test/test_*.cpp
!firmware/test/test_*.h

# Editor
.vscode/
*.swp
